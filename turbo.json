{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "AI_GATEWAY_API_KEY",
    "BETTER_AUTH_SECRET",
    "CARER_TOKEN_SECRET",
    "DATABASE_URL",
    "EXPO_PUBLIC_API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NODE_ENV",
    "PORT",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SKIP_ENV_VALIDATION",
    "STORAGE_DRIVER",
    "WEB_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_APP_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:check": {
      "cache": false
    },
    "db:export": {
      "cache": false
    },
    "db:pull": {
      "cache": false
    },
    "db:up": {
      "cache": false
    },
    "storage:init": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test:integration": {
      "cache": false
    }
  }
}
