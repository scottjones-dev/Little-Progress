{
  "name": "littleprogress",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "db:check": "turbo run db:check",
    "db:export": "turbo run db:export",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:pull": "turbo run db:pull",
    "db:push": "turbo run db:push",
    "db:up": "turbo run db:up",
    "infra:up": "docker compose -f infra/postgres/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/postgres/docker-compose.yml down"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.5",
    "typescript": "7.0.2",
    "ultracite": "7.12.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
