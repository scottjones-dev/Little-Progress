{
  "name": "littleprogress",
  "private": true,
  "license": "MIT",
  "scripts": {
    "auth:generate": "infisical run --path=/api -- pnpm dlx auth@latest generate --config ./packages/auth/src/auth.ts --output ./packages/db/src/schemas/auth.ts -y",
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:check": "turbo run db:check",
    "db:export": "turbo run db:export",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:local": "turbo run db:migrate:local",
    "db:pull": "turbo run db:pull",
    "db:push": "turbo run db:push",
    "db:up": "turbo run db:up",
    "dev": "turbo run dev",
    "dev:local": "turbo run dev:local",
    "fix": "ultracite fix",
    "i18n:check": "pnpm --filter @repo/i18n i18n:check",
    "i18n:translate": "pnpm --filter @repo/i18n i18n:translate",
    "infra:down": "pnpm infra:postgres:down && pnpm infra:storage:down",
    "infra:postgres:down": "docker compose -f infra/postgres/docker-compose.yml down",
    "infra:postgres:up": "docker compose -f infra/postgres/docker-compose.yml up -d",
    "infra:storage:down": "docker compose -f infra/storage/docker-compose.yml down",
    "infra:storage:up": "docker compose -f infra/storage/docker-compose.yml up -d",
    "infra:up": "pnpm infra:postgres:up && pnpm infra:storage:up",
    "prepare": "husky",
    "secrets:push": "infisical secrets set --env=dev --path=/api --file=.env",
    "secrets:seed": "pnpm --filter @repo/env secrets:seed",
    "setup:local": "pnpm --filter @repo/env setup:local",
    "storage:init": "turbo run storage:init",
    "storage:init:local": "turbo run storage:init:local",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:integration:local": "turbo run test:integration:local"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.5",
    "typescript": "7.0.2",
    "ultracite": "7.12.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
