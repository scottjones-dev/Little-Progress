{
  "name": "@repo/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client/*": "./src/client/*.ts",
    "./server/*": "./src/server/*.ts",
    "./shared/*": "./src/shared/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "storage:init": "infisical run --path=/api -- tsx src/server/init.ts",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "infisical run --path=/api -- vitest run integration",
    "storage:init:local": "dotenv -e ../../.env -- tsx src/server/init.ts",
    "test:integration:local": "dotenv -e ../../.env -- vitest run integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@repo/config": "workspace:*",
    "@repo/env": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
