{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./vocab": "./src/vocab.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "infisical run --path=/api -- drizzle-kit studio",
    "db:check": "infisical run --path=/api -- drizzle-kit check",
    "db:export": "infisical run --path=/api -- drizzle-kit export",
    "db:generate": "infisical run --path=/api -- drizzle-kit generate",
    "db:migrate": "infisical run --path=/api -- drizzle-kit migrate",
    "db:pull": "infisical run --path=/api -- drizzle-kit pull",
    "db:push": "infisical run --path=/api -- drizzle-kit push",
    "db:up": "infisical run --path=/api -- drizzle-kit up",
    "dev:local": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:migrate:local": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:generate:local": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:check:local": "dotenv -e ../../.env -- drizzle-kit check"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
