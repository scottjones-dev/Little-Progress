# Secrets live in Infisical (project: littleprogress). This file only lists key names.
# Local fallback: copy to .env.local in the relevant app. Never commit real values.

# --- api (Infisical path: /api) ---
NODE_ENV=development
PORT=9000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=
BETTER_AUTH_SECRET=
CARER_TOKEN_SECRET=
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
NOVU_REGION=eu
NOVU_SECRET_KEY=
AI_GATEWAY_API_KEY=

# --- web (Infisical path: /web) ---
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- native (Infisical path: /native) ---
EXPO_PUBLIC_API_URL=http://localhost:9000
