# Secrets live in Infisical (project: littleprogress). This file only lists key names.
# Infisical dashboard: https://app.infisical.com  (docs: https://infisical.com/docs/documentation/getting-started/introduction)
# Local fallback: copy to .env.local in the relevant app. Never commit real values.

# --- api (Infisical path: /api) ---
NODE_ENV=development
PORT=9000
WEB_ORIGIN=http://localhost:3000

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DB
# Local: `pnpm infra:postgres:up` (see infra/postgres/README.md), value is postgres://postgres:postgres@localhost:5432/littleprogress
# Hosted (pick one): Neon https://console.neon.tech (Project > Connection Details)
#                    Supabase https://supabase.com/dashboard (Project > Connect)
DATABASE_URL=

# Random 32+ char secret used by Better Auth to sign sessions/cookies.
# Generate: openssl rand -base64 32      (docs: https://www.better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_SECRET=

# Public URL of the API where /api/auth/* is served (used to build verify and reset links).
# Local: http://localhost:9000
BETTER_AUTH_URL=

# Google sign-in (optional). Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (optional). Entra ID app registration: https://entra.microsoft.com
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Passkeys are bound to this domain (no scheme or port). `localhost` in development.
PASSKEY_RP_ID=localhost

# Sentry error reporting (EU region). Create a Sentry org with EU data storage, then a project
# named "api" (platform Node/Hono). Copy its DSN: Project > Settings > Client Keys (DSN).
# Leave empty to turn error reporting off. See docs/error-handling.md.
SENTRY_DSN=
# Defaults to NODE_ENV (development, production). Set "staging" for the staging API.
SENTRY_ENVIRONMENT=
# Git commit SHA, set by CI so errors are grouped per release.
SENTRY_RELEASE=

# Random 32+ char secret used to sign carer access tokens. Use a different value from the one above.
# Generate: openssl rand -base64 32
CARER_TOKEN_SECRET=

# "s3" for any S3-compatible store (AWS S3, Cloudflare R2, Floci locally). See packages/storage/README.md
STORAGE_DRIVER=s3

# Cloudflare R2: https://dash.cloudflare.com > R2 Object Storage > your bucket > Settings > S3 API
#   endpoint looks like https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (docs: https://developers.cloudflare.com/r2/api/s3/api/)
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. eu-west-2)  (console: https://console.aws.amazon.com/s3)
#
# LOCAL DEV (Floci, `pnpm infra:storage:up` then `pnpm storage:init`). These are the real dev values, use them as-is:
#   S3_ENDPOINT=http://localhost:4566
#   S3_REGION=us-east-1
#   S3_BUCKET=littleprogress-dev
#   S3_ACCESS_KEY_ID=test
#   S3_SECRET_ACCESS_KEY=test
#   S3_FORCE_PATH_STYLE=true
# (UI to browse the bucket: http://localhost:4500. test/test is a throwaway emulator login, not a secret.)
#
# Below: the values for a real bucket (R2 shown). Replace with the Floci values above when running locally.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=

# R2 keys: R2 Object Storage > Manage API Tokens > Create API token (Object Read & Write)
#   https://dash.cloudflare.com/?to=/:account/r2/api-tokens   (docs: https://developers.cloudflare.com/r2/api/tokens/)
# AWS keys: IAM > Users > Security credentials > Create access key  https://console.aws.amazon.com/iam
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# true for Floci/MinIO (path-style URLs), false for R2 and AWS S3
S3_FORCE_PATH_STYLE=false

# Novu (notifications): https://dashboard.novu.co
# Region: "eu" or "us", matches the region you picked when creating the account
# Secret key: Dashboard > API Keys  https://dashboard.novu.co/api-keys  (docs: https://docs.novu.co/platform/quickstart/nextjs)
NOVU_REGION=eu
NOVU_SECRET_KEY=

# Vercel AI Gateway key: https://vercel.com/dashboard > AI Gateway > API Keys
#   (docs: https://vercel.com/docs/ai-gateway/authentication-and-byok/authentication)
AI_GATEWAY_API_KEY=

# --- web (Infisical path: /web) ---
# Public URLs, safe to expose to the browser. Point at your deployed API/web in prod.
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry project "web" (platform Next.js): Project > Settings > Client Keys (DSN). Public by design.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps (readable stack traces). Never commit it.
# Token: https://sentry.io/settings/account/api/auth-tokens/ (EU: https://de.sentry.io/settings/account/api/auth-tokens/)
SENTRY_AUTH_TOKEN=
# Your Sentry organization slug and the web project slug.
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog EU project token for the web app: https://eu.posthog.com > Project settings > Project token.
# Public by design (it can only send events). Leave empty to turn analytics off. See docs/analytics.md.
NEXT_PUBLIC_POSTHOG_TOKEN=

# --- native (Infisical path: /native) ---
# Public URL, bundled into the app. On a physical device use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:9000

# Sentry project "native" (platform React Native): Project > Settings > Client Keys (DSN). Public by design.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog EU project token for the native app (the same project as web is fine, or a separate one).
EXPO_PUBLIC_POSTHOG_TOKEN=

# --- i18n (Infisical path: /i18n) ---
# Only used by `pnpm i18n:translate`, never by the running apps. Languine account: https://languine.ai
# After `npx languine@latest auth login` and `init`, the project id is in packages/i18n/languine.json.
LANGUINE_API_KEY=
LANGUINE_PROJECT_ID=
