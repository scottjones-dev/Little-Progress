{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --path=/api -- tsx watch --import ./src/instrument.ts src/index.ts",
    "start": "infisical run --path=/api -- tsx --import ./src/instrument.ts src/index.ts",
    "check-types": "tsc --noEmit",
    "dev:local": "tsx watch --import ./src/instrument.ts src/index.ts",
    "start:local": "tsx --import ./src/instrument.ts src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@repo/auth": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@sentry/hono": "^11.1.0",
    "@sentry/node": "^11.1.0",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
